NODE_ENV=development

API_PORT=3001
API_CORS_ORIGIN=http://localhost:3000
TRUST_PROXY_HOPS=0
WEB_APP_URL=http://localhost:3000

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=vale
DATABASE_PASSWORD=vale
DATABASE_NAME=vale_project
# Para banco remoto, use verify-full, uma CA confiável montada pelo cofre e nunca desabilite a
# validação de certificado. Produção exige ambos.
DATABASE_SSL_MODE=disable
# DATABASE_SSL_CA=-----BEGIN CERTIFICATE-----...\n-----END CERTIFICATE-----

JWT_ACCESS_SECRET=dev-access-secret-change-before-production
JWT_ISSUER=vale-api
JWT_AUDIENCE=vale-web
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Em produção atrás do proxy same-origin, use /api/auth.
REFRESH_COOKIE_PATH=/auth
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=15

# Swagger fica disponível apenas quando explicitamente habilitado e é recusado em produção.
SWAGGER_ENABLED=true

LEGAL_TERMS_VERSION=terms-2026-07-24
LEGAL_PRIVACY_VERSION=privacy-2026-07-24
LEGAL_GUIDELINES_VERSION=guidelines-2026-07-24

# O provider log é permitido apenas fora de produção.
EMAIL_PROVIDER=log
EMAIL_FROM=no-reply@local.vale.test
# Para produção, use EMAIL_PROVIDER=http e configure ambos:
# EMAIL_HTTP_ENDPOINT=https://provider.example/send
# EMAIL_HTTP_TOKEN=troque-pelo-token-do-provider

# A outbox protege destinatários e tokens transitórios com AES-256-GCM. Gere a chave fora do
# repositório (por exemplo: openssl rand -base64 32). Produção exige uma chave real.
OUTBOX_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
OUTBOX_KEY_VERSION=v1
OUTBOX_DISPATCH_ENABLED=false
OUTBOX_POLL_INTERVAL_SECONDS=30
OUTBOX_DISPATCH_BATCH_SIZE=20
OUTBOX_LEASE_SECONDS=120
OUTBOX_MAX_ATTEMPTS=8
# A compatibilidade de idempotência permite rollout gradual; torne obrigatória só após o Web usar
# Idempotency-Key em todas as criações protegidas.
IDEMPOTENCY_REQUIRED=false
PRIVACY_GOVERNANCE_APPROVED=false
PRIVACY_EXPORT_ENABLED=false
ACCOUNT_DELETION_ENABLED=false
ERASURE_DRY_RUN=true

# Arquivos de perfil ficam fora da pasta pública e só saem por endpoint autorizado.
STORAGE_DRIVER=local
PROFILE_STORAGE_ROOT=.data/profile-uploads
# Produção exige clamav; local/teste podem usar disabled somente com arquivos fictícios.
FILE_SCAN_DRIVER=disabled
# CLAMAV_HOST=clamav.internal
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MILLISECONDS=5000
# Buckets expirados são limpos por manutenção periódica, nunca no caminho da requisição.
RATE_LIMIT_CLEANUP_INTERVAL_SECONDS=300
JOB_ACTIVE_LIMIT=3
# O snapshot é removido após este prazo quando a candidatura ou a vaga já terminou.
APPLICATION_RESUME_RETENTION_DAYS=180
# Job recorrente com lock distribuído; o intervalo máximo aceito é diário.
RETENTION_JOB_INTERVAL_SECONDS=86400
RETENTION_JOB_BATCH_SIZE=100
RETENTION_JOB_MAX_ITEMS_PER_CYCLE=1000
RETENTION_ALERT_AGE_SECONDS=86400
# Em produção, use STORAGE_DRIVER=s3 com S3, R2 ou serviço compatível:
# S3_ENDPOINT=https://storage.example
# S3_BUCKET=vale-profile-files
# S3_REGION=auto
# S3_ACCESS_KEY_ID=troque-pela-chave
# S3_SECRET_ACCESS_KEY=troque-pelo-segredo
S3_TIMEOUT_MILLISECONDS=5000
S3_MAX_RETRIES=2
S3_CIRCUIT_FAILURE_THRESHOLD=5
S3_CIRCUIT_RESET_SECONDS=30

# Opcionais e somente para bootstrap local/desenvolvimento:
# SEED_ADMIN_EMAIL=admin@local.vale.test
# SEED_ADMIN_PASSWORD=troque-esta-senha-local

NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
# Em produção, a origem pública única encaminha /api/* para a API:
# NEXT_PUBLIC_API_BASE_URL=/api
