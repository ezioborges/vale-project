{
  "name": "vale-project",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "corepack pnpm --parallel --recursive dev",
    "build": "corepack pnpm --recursive build",
    "lint": "corepack pnpm --recursive lint",
    "test": "corepack pnpm --recursive test",
    "test:integration": "corepack pnpm --filter @vale/api test:integration",
    "typecheck": "corepack pnpm --recursive typecheck",
    "validate": "corepack pnpm format:check && corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test && corepack pnpm test:integration && corepack pnpm build",
    "audit:prod": "node scripts/audit-prod.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,css,yml,yaml,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,css,yml,yaml,md}\"",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "db:reset:dev": "docker compose --profile maintenance run --rm db-reset",
    "db:reseed:dev": "docker compose --profile maintenance run --rm db-reseed"
  },
  "pnpm": {
    "overrides": {
      "body-parser": "2.3.0",
      "brace-expansion@^2.0.0": "2.1.2",
      "brace-expansion@^5.0.0": "5.0.8",
      "js-yaml@^5.0.0": "5.2.2",
      "postcss": "8.5.18",
      "sharp": "0.35.0"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@next/eslint-plugin-next": "^16.2.9",
    "eslint": "^9.29.0",
    "globals": "^16.2.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.1"
  }
}
